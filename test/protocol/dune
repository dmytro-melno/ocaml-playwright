(rule
 (target generator_test.ml)
 (deps ../../tools/generate_api_v2.ml)
 (action
  (with-stdout-to %{target}
   (run sed "/^let () =/,$d" %{deps}))))

(rule
 (targets fixture.ml fixture.mli)
 (deps fixture.yml)
 (action
  (progn
   (with-stdout-to fixture.ml
    (progn (echo "open Playwright\n") (run %{exe:../../tools/generate_api_v2.exe} ml %{deps})))
   (with-stdout-to fixture.mli
    (progn (echo "open Playwright\n") (run %{exe:../../tools/generate_api_v2.exe} mli %{deps}))))))

(executable
 (name schema_tests)
 (modules schema_tests generator_test)
 (libraries playwright yaml re.pcre yojson))

(executable
 (name codec_tests)
 (modules codec_tests fixture)
 (libraries playwright eio_main)
 (preprocess (pps ppx_deriving_yojson)))

(executable
 (name live_tests)
 (modules live_tests)
 (libraries playwright eio_main))

(rule
 (alias runtest)
 (locks %{workspace_root}/eio-tests)
 (deps fixture.yml ../../protocol/protocol.yml ../../protocol/provenance.json ../../lib/api.ml ../../lib/api.mli ../../lib/playwright.cma offline_checks.sh fixture.cjs reference.cjs)
 (action
  (progn
   (run timeout --signal=TERM --kill-after=3s 20s %{exe:../../tools/verify_protocol.exe} check ../../protocol/protocol.yml ../../protocol/provenance.json)
   (run timeout --signal=TERM --kill-after=3s 25s sh %{dep:offline_checks.sh} %{exe:../../tools/generate_api_v2.exe} %{exe:../../tools/verify_protocol.exe} %{ocamlc})
   (run timeout --signal=TERM --kill-after=3s 25s %{exe:schema_tests.exe})
   (run timeout --signal=TERM --kill-after=3s 20s %{exe:codec_tests.exe})
   (run timeout --signal=TERM --kill-after=3s 45s node %{dep:fixture.cjs} %{exe:live_tests.exe})
   (run timeout --signal=TERM --kill-after=3s 45s node %{dep:reference.cjs}))))
