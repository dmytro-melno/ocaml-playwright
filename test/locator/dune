(executables
 (names browser_tests ownership_tests)
 (libraries playwright eio_main unix))

(rule
 (alias runtest)
 ; Eio io_uring rings share the host's small per-user memlock budget.
 (locks %{workspace_root}/eio-tests)
 (deps fixture.js latency-fixture.json reference.cjs)
 (action
  (progn
   (run timeout --signal=TERM --kill-after=3s 40s %{exe:browser_tests.exe} strict)
   (run timeout --signal=TERM --kill-after=3s 40s %{exe:browser_tests.exe} selectors)
   (run timeout --signal=TERM --kill-after=3s 45s %{exe:browser_tests.exe} helpers)
   (run timeout --signal=TERM --kill-after=3s 35s %{exe:browser_tests.exe} latency)
   (run timeout --signal=TERM --kill-after=3s 25s %{exe:ownership_tests.exe})
   (run timeout --signal=TERM --kill-after=3s 40s node %{dep:reference.cjs}))))
