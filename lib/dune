(library
 (name playwright)
 (public_name playwright)
 (libraries yojson eio unix base64)
 (preprocess
  (pps ppx_deriving_yojson)))

(rule
 (targets api_v2.mli api_v2.ml)
 (deps %{workspace_root}/deps/playwright/packages/protocol/src/protocol.yml %{workspace_root}/tools/generate_api_v2.exe)
 (action
  (progn
   (with-stdout-to
    api_v2.mli
    (chdir
     %{workspace_root}
     (run tools/generate_api_v2.exe mli)))
   (with-stdout-to
    api_v2.ml
    (chdir
     %{workspace_root}
     (run tools/generate_api_v2.exe ml))))))
