
(library
 (name playwright)
 (public_name playwright)
 (libraries yojson eio unix base64)
 (preprocess
  (pps ppx_deriving_yojson)))

(rule
 (targets api.mli api.ml)
 (deps ../deps/playwright/packages/protocol/src/protocol.yml)
 (action
  (progn
   (with-stdout-to
    api.mli
    (run %{exe:../tools/generate_api_v2.exe} mli %{deps}))
   (with-stdout-to
    api.ml
    (run %{exe:../tools/generate_api_v2.exe} ml %{deps})))))
