(library
 (name playwright)
 (public_name playwright)
 (libraries eio eio.unix yojson base64 unix threads.posix))

; [protocol.ml] is generated from protocol/ but checked in, so that building the library needs
; neither the generator nor its dependencies.  [dune build @gen --auto-promote] refreshes it and
; [dune runtest] fails when it is stale.

(rule
 (targets protocol.ml.gen)
 (deps
  %{project_root}/protocol/manifest.json
  (glob_files %{project_root}/protocol/spec/*.yml))
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:../tools/gen_protocol/gen_protocol.exe} %{project_root}/protocol/manifest.json %{project_root}/protocol/spec))))

(rule
 (alias gen)
 (action
  (diff protocol.ml protocol.ml.gen)))

(rule
 (alias runtest)
 (action
  (diff protocol.ml protocol.ml.gen)))
