(library
 (name playwright)
 (public_name playwright)
 (libraries yojson eio eio_linux mtime.clock.os base64 zip)
 (preprocess
  (pps ppx_deriving_yojson)))

(rule
 (targets api.mli api.ml)
 (deps ../protocol/protocol.yml ../protocol/provenance.json)
 (action
  (progn
    (run %{exe:../tools/verify_protocol.exe} check ../protocol/protocol.yml ../protocol/provenance.json)
    (with-stdout-to api.mli (run %{exe:../tools/generate_api_v2.exe} mli ../protocol/protocol.yml))
    (with-stdout-to api.ml (run %{exe:../tools/generate_api_v2.exe} ml ../protocol/protocol.yml)))))

(rule
 (target protocol_version.ml)
 (deps ../protocol/protocol.yml ../protocol/provenance.json)
 (action
  (with-stdout-to %{target}
   (run %{exe:../tools/verify_protocol.exe} ml ../protocol/protocol.yml ../protocol/provenance.json))))
