# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.2.0"
synopsis: "Browser automation with Playwright for OCaml"
description: """
A client for the Playwright browser automation driver, built on Eio.
It drives Chromium, Firefox and WebKit through the same API as the official Playwright
libraries: auto-waiting locators, network interception, tracing and more."""
maintainer: ["Dmytro Melnychuk"]
authors: ["Dmytro Melnychuk"]
license: "MIT"
homepage: "https://github.com/dmytro-melno/ocaml-playwright"
bug-reports: "https://github.com/dmytro-melno/ocaml-playwright/issues"
depends: [
  "dune" {>= "3.10"}
  "ocaml" {>= "5.2.0"}
  "eio" {>= "1.0"}
  "cstruct" {>= "6.0.0"}
  "yojson" {>= "3.0.0"}
  "base64" {>= "3.0.0"}
  "re" {>= "1.10.0"}
  "eio_main" {with-test & >= "1.0"}
  "alcotest" {with-test & >= "1.7.0"}
  "yaml" {with-test & >= "3.0.0"}
  "digestif" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dmytro-melno/ocaml-playwright.git"
