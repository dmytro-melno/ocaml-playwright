opam-version: "2.0"
synopsis: "OCaml bindings for Playwright"
description: "OCaml bindings for Playwright generated from protocol.yml"
maintainer: ["dmytrom"]
authors: ["dmytrom"]
homepage: "https://github.com/dmytrom/ocaml-playwright"
bug-reports: "https://github.com/dmytrom/ocaml-playwright/issues"
depends: [
  "ocaml" {>= "5.0.0"}
  "dune" {>= "3.10"}
  "eio_main"
  "yojson"
  "ppx_deriving_yojson"
  "yaml"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dmytrom/ocaml-playwright.git"
